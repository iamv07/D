import pandas as pd
import numpy as np
from scipy import stats
df = pd.DataFrame({'Salary': [30, 35, 40, 42, 45, 48, 50, 52, 55, 58, 60, 62, 65, 150, 180]})
Q1 = df['Salary'].quantile(0.25)
Q2 = df['Salary'].quantile(0.50)
Q3 = df['Salary'].quantile(0.75)
p90 = df['Salary'].quantile(0.90)
print(f"Q1: {Q1}, Q2: {Q2}, Q3: {Q3}, 90th Percentile: {p90}")
IQR = Q3 - Q1
lower_bound = Q1 - 1.5 * IQR
upper_bound = Q3 + 1.5 * IQR
print("\nIQR Outliers:\n", df[(df['Salary'] < lower_bound) | (df['Salary'] > upper_bound)])
df['Z_Score'] = stats.zscore(df['Salary'])
print("\nZ-Score Outliers:\n", df[np.abs(df['Z_Score']) > 2])

import pandas as pd
from sklearn.preprocessing import LabelEncoder
df = pd.DataFrame({'Name': ['Smaran', 'Sachin', 'Samarpan', 'Spandan', 'Shravan'], 'Address': ['Pune', 'Mumbai', 'Delhi', 'Chennai', 'Madurai'], 'Age': [20, 23, 19, 21, 22], 'Class': ['BE', 'BSc(CS)', 'BVOC', 'BCom', 'BSc']})
df_encoded = pd.get_dummies(df, columns=['Name'])
le = LabelEncoder()
df_encoded['Class_Encoded'] = le.fit_transform(df['Class'])
print(df_encoded)
